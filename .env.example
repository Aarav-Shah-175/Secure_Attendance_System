# Production Environment Variables for Secure Attendance System
SECRET_KEY=generate_a_random_secret_key_here
AES_MASTER_KEY=dev-aes-master-key-32bytes-long!
DEBUG=False

# Database credentials
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_HOST=db
DB_PORT=5432

# WebAuthn Domain Configuration
WEBAUTHN_RP_ID=192-168-137-1.sslip.io
WEBAUTHN_RP_NAME=Secure Attendance System
WEBAUTHN_ORIGIN=https://192-168-137-1.sslip.io:8000

# Attendance Agent Configuration
ATTENDANCE_AGENT_URL=http://127.0.0.1:5000
ATTENDANCE_AGENT_API_TOKEN=secure_presence_v3_default_token
ATTENDANCE_AGENT_DEV_BYPASS=False
