# ==============================================================================
# Secure Attendance System - Environment Variables Template
# Copy this file to '.env' and populate with your own deployment values.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Django Security
# Generate a secret key with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=your_django_secret_key_here
DEBUG=False

# Master AES Key for encrypting stored professor/agent private keys (Exactly 32 characters)
# Generate with: python -c 'import secrets; print(secrets.token_hex(16))'
AES_MASTER_KEY=your_32_byte_aes_master_key_here

# PostgreSQL Database Credentials
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_HOST=db
DB_PORT=5432

# ==============================================================================
# Server Host & WebAuthn / SSL Domain (EC2 Deployment)
# When EC2 starts with a new public IP, update these values:
# (e.g. SERVER_IP=54.210.12.34 and WEBAUTHN_RP_ID=54-210-12-34.sslip.io)
# ==============================================================================
SERVER_IP=your_ec2_public_ipv4_here
SERVER_PORT=443
WEBAUTHN_RP_ID=your-ip-with-hyphens.sslip.io
WEBAUTHN_RP_NAME=Secure Attendance System

# Attendance Agent Configuration
# Professor Hotspot agent address (e.g. http://192.168.137.1:5000)
ATTENDANCE_AGENT_URL=http://192.168.137.1:5000
ATTENDANCE_AGENT_API_TOKEN=your_strong_agent_api_token_here
ATTENDANCE_AGENT_DEV_BYPASS=False
